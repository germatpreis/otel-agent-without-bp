{
  "namespace": "xtype.environment.event.external.v1.data",
  "type": "record",
  "name": "CustomerEnvironmentUpdatedEventV1",
  "doc": "Full snapshot of a customer's environment with flat stage and instance arrays.",
  "fields": [
    {
      "name": "environmentId",
      "type": "string",
      "doc": "The customer environment aggregate ID."
    },
    {
      "name": "stages",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "Stage",
          "fields": [
            { "name": "id", "type": "string", "doc": "Unique stage ID." },
            { "name": "name", "type": "string", "doc": "Display name of the stage." },
            { "name": "position", "type": "int", "doc": "Order within the environment." },
            { "name": "production", "type": "boolean", "doc": "Whether this is the production stage." },
            {
              "name": "instanceIds",
              "type": { "type": "array", "items": "string" },
              "default": [],
              "doc": "Ordered list of instance IDs assigned to this stage."
            }
          ]
        }
      },
      "doc": "All visible stages in the environment, ordered by position."
    },
    {
      "name": "instances",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "Instance",
          "fields": [
            { "name": "id", "type": "string", "doc": "Instance ID (ServiceNow instance sys_id)." },
            { "name": "name", "type": "string", "doc": "Instance name (e.g. dev01)." },
            { "name": "active", "type": "boolean", "default": true, "doc": "Whether the instance is active." },
            { "name": "enableDeployments", "type": "boolean", "doc": "Whether deployments are enabled." },
            { "name": "description", "type": "string", "doc": "Instance description." },
            { "name": "instanceCustomUrl", "type": "string", "doc": "Custom URL for the instance." },
            { "name": "majorVersion", "type": "string", "doc": "ServiceNow major version." },
            { "name": "patchLevel", "type": "string", "doc": "ServiceNow patch level." }
          ]
        }
      },
      "doc": "All instances in the environment. Stages reference them by ID via instanceIds."
    }
  ]
}
