{
  "namespace": "xtype.xus_legacy.v1.data",
  "type": "record",
  "name": "XusDeletionEventV1",
  "doc": "This payload is used to trigger a deletion of all defined XUS.",
  "fields": [
    {
      "name": "table",
      "type": "string",
      "doc": "The original name of the table in SN."
    },
    {
      "name": "sysIds",
      "type": {
        "type": "array",
        "items": "string"
      },
      "doc": "A list of sysIds for xus or rus that should be delete."
    }
  ]
}
