            <import>${avro-spec-base-dir}/xtype/xus-legacy/v1/data/xus_deletion_event.avsc</import>
            <import>${avro-spec-base-dir}/xtype/xus-legacy/v1/data/xus_recalculation_event.avsc</import>

            <!-- DOMAIN: DEPLOYMENT HEADERS -->
            <import>${avro-spec-base-dir}/xtype/deployment/state/common/v1/other_problem.avsc</import>
            <import>${avro-spec-base-dir}/xtype/deployment/state/common/v1/pending_approval.avsc</import>
            <import>${avro-spec-base-dir}/xtype/deployment/state/common/v1/preview_problem.avsc</import>
