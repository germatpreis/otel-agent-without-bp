            <import>${avro-spec-base-dir}/xtype/deployment/state/common/v2/xus_header.avsc</import>
            <import>${avro-spec-base-dir}/xtype/deployment/state/common/v2/update_set_header.avsc</import>
            <import>${avro-spec-base-dir}/xtype/deployment/state/update-set-deployment-event-external/v2/update_set_deployment_blocked.avsc</import>
            <import>${avro-spec-base-dir}/xtype/deployment/state/update-set-deployment-event-external/v2/update_set_deployment_failed.avsc</import>
            <import>${avro-spec-base-dir}/xtype/deployment/state/update-set-deployment-event-external/v2/update_set_deployment_finished_ok_event.avsc</import>

            <import>${avro-spec-base-dir}/xtype/deployment/package-event-external/v1/data/package_content_type.avsc</import>
            <import>${avro-spec-base-dir}/xtype/deployment/package-event-external/v1/data/package_content_update_set.avsc</import>
