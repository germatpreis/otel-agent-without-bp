            <import>${avro-spec-base-dir}/xtype/deployment/package-event-external/v1/data/package_created_event.avsc</import>

            <!-- NOTIFICATION -->
            <import>${avro-spec-base-dir}/xtype/notifications/notification/common/v1/mail_notification.avsc</import>
            <import>${avro-spec-base-dir}/xtype/notifications/notification/common/v1/msteams_notification.avsc</import>
            <import>${avro-spec-base-dir}/xtype/notifications/notification/common/v1/slack_notification.avsc</import>
            <import>${avro-spec-base-dir}/xtype/notifications/notification/event-external/v1/notification_created.avsc</import>
