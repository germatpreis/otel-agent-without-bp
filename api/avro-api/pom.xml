        <artifactId>avro-maven-plugin</artifactId>
        <configuration>
          <sourceDirectory>${avro-spec-base-dir}</sourceDirectory>
          <outputDirectory>${project.build.directory}/generated-sources/avro</outputDirectory>
          <imports>
            <!-- COMMON ACROSS ALL CONTEXTS -->
            <import>${avro-spec-base-dir}/xtype/common/base.avsc</import>
            <import>${avro-spec-base-dir}/xtype/common/user.avsc</import>

            <!-- SERVICE: SNOW-SYNC -->
            <import>${avro-spec-base-dir}/xtype/snow-sync/common/snow_base.avsc</import>
            <import>${avro-spec-base-dir}/xtype/snow-sync/common/snow_deletion_event.avsc</import>

            <!-- SERVICE: SNOW-SYNC/LEGACY -->
